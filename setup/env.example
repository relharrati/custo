# Custo Environment Configuration
# Copy this file to .env and fill in your values

# System Settings
CUSTO_ROOT=/path/to/custo
CUSTO_ENV=development

# Integration Keys (optional)
# Discord Bot Token (for Discord gateway)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# WhatsApp API (for WhatsApp gateway)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER=

# Notion Integration
NOTION_API_KEY=
NOTION_DATABASE_ID=

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=

# Email Configuration
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# External Services
OPENAI_API_KEY=  # For AI-powered features
ANTHROPIC_API_KEY=

# Web Dashboard
WEB_PORT=8080
WEB_HOST=127.0.0.1

# Logging
LOG_LEVEL=INFO
